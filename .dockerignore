# MCP Builder - Docker ignore file
# Optimizes build context and reduces image size

# Git and version control
.git/
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.env

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Documentation
docs/_build/
.readthedocs/

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
.tmp/

# Claude Code specific
.claude/

# Development files
README.md
LICENSE
CHANGELOG.md
*.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker files (don't include in build context)
Dockerfile*
docker-compose*.yml
.dockerignore

# UV cache (will be managed by Docker cache mounts)
.cache/

# OS specific
Thumbs.db
.DS_Store
Desktop.ini

# IDE specific
.vscode/
.idea/
*.sublime-*

# Backup files
*.bak
*.backup